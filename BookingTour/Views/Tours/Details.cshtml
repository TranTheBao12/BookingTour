@model BookingTour.Models.Tour

@{
    ViewData["Title"] = "Chi tiết Tour - " + Model.Name;
    Layout = "_LayoutUser"; // Nếu bạn muốn sử dụng layout riêng, hãy thay thế bằng layout phù hợp
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["SuccessMessage"]
    </div>
}
@{
   
    var isFavorited = Model.UsersFavoriteTours.Any(f => f.IdTour == Model.IdTour && f.Id == ViewBag.UserId);
    /* var imagesList = Model.images.ToList(); */ // Chuyển đổi ICollection thành List
}

<!doctype html>

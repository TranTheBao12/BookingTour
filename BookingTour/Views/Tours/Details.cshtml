                alert("Vui lòng chọn số lượng người hợp lệ.");
                return;
            }
            alert("Bạn đã đặt tour thành công với " + quantity + " người.");
        }
    </script>
<script>
    function updateTotal() {
        const quantity = document.getElementById("quantity").value;
        const pricePerPerson = parseFloat('@Model.Price'); // Lấy giá từ model
        const total = quantity * pricePerPerson;
        document.getElementById("totalPrice").textContent = total.toFixed(2) + ' VNĐ';
    }
</script>

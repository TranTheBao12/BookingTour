    <h1 class="tour-title">@Model.Name</h1>
        <div class="comment-count">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chat-dots" viewBox="0 0 16 16">
                <path d="M5 8a1 1 0 1 1-2 0 1 1 0 0 1 2 0m4 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0m3 1a1 1 0 1 0 0-2 1 1 0 0 0 0 2" />
                <path d="m2.165 15.803.02-.004c1.83-.363 2.948-.842 3.468-1.105A9 9 0 0 0 8 15c4.418 0 8-3.134 8-7s-3.582-7-8-7-8 3.134-8 7c0 1.76.743 3.37 1.97 4.6a10.4 10.4 0 0 1-.524 2.318l-.003.011a11 11 0 0 1-.244.637c-.079.186.074.394.273.362a22 22 0 0 0 .693-.125m.8-3.108a1 1 0 0 0-.287-.801C1.618 10.83 1 9.468 1 8c0-3.192 3.004-6 7-6s7 2.808 7 6-3.004 6-7 6a8 8 0 0 1-2.088-.272 1 1 0 0 0-.711.074c-.387.196-1.24.57-2.634.893a11 11 0 0 0 .398-2" />
            </svg> @Model.Comments.Count()<strong> đánh giá<br /></strong>
        </div>
        &nbsp;
        @if (Model.images != null && Model.images.Any())
        {
            var imageList = Model.images.ToList(); // Chuyển đổi ICollection<Image> thành List<Image>

            <div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel">
                <!-- Indicators -->
                <ol class="carousel-indicators">
                    @for (int i = 0; i < imageList.Count; i++)
                    {
                        <li data-target="#carouselExampleIndicators" data-slide-to="@i" class="@(i == 0 ? "active" : "")"></li>
                    }
                </ol>

                <!-- Wrapper for slides -->
                <div class="carousel-inner">
                    @for (int i = 0; i < imageList.Count; i++)
                    {
                        var imagePath = Url.Content("~/images/" + imageList[i].ImageUrl);
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@imagePath" class="d-block w-100 img-fluid rounded-20" alt="Image @i" style="   max-height: 400px; /* Chiều cao tối đa của hình ảnh */
    object-fit: cover; /* Cắt hình ảnh theo tỷ lệ mà không làm méo */
    width: 100%;" />
                        </div>
                    }
                </div>

                <!-- Controls -->
                <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="sr-only">Previous</span>
                </a>
                <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="sr-only">Next</span>
                </a>
            </div>
        }
        else
        {
            <p>Không có hình ảnh nào cho tour này.</p>
        }

     
        <div class="owl-single dots-absolute owl-carousel">
            <img src="images/slider-1.jpg" alt="Free HTML Template by Untree.co" class="img-fluid rounded-20">
            <img src="images/slider-2.jpg" alt="Free HTML Template by Untree.co" class="img-fluid rounded-20">
            <img src="images/slider-3.jpg" alt="Free HTML Template by Untree.co" class="img-fluid rounded-20">
            <img src="images/slider-4.jpg" alt="Free HTML Template by Untree.co" class="img-fluid rounded-20">
            <img src="images/slider-5.jpg" alt="Free HTML Template by Untree.co" class="img-fluid rounded-20">
        </div>
        <div class="row">
            <div class="col-md-8">
                <div class="tour-info">
                    <h2>Thông tin tour</h2>
                    <ul>
                        <li>Ngày khởi hành: @Model.StartDate,</li>
                        <li>Ngày kết thúc: @Model.EndDate,</li>
                        <li>Số ngày: @Model.MaxQuantity ngày</li>
                        <li>Điểm khởi hành: Hà Nội</li>
                        <li>Điểm đến: @Model.IdTransNavigation?.IdTrans</li>
                    </ul>
                </div>

                <div class="tour-details">
                    <h2>Lịch trình tour</h2>
                    <ul>
                        <li>Ngày 1: Hà Nội - Bangkok, Đi máy bay từ Hà Nội đến Bangkok</li>
                        <li>Ngày 2: Bangkok, Tham quan Cung điện Vương quốc, Chùa Phật Ngọc</li>
                        <li>Ngày 3: Bangkok - Pattaya, Đi xe bus từ Bangkok đến Pattaya</li>
                        <li>Ngày 4: Pattaya, Tham quan Công Viên Khủng Long, biển Pattaya</li>
                        <li>Ngày 5: Pattaya - Bangkok, Đi xe bus từ Pattaya đến Bangkok</li>
                        <li>Ngày 6: Bangkok - Hà Nội, Đi máy bay từ Bangkok đến Hà Nội</li>
                    </ul>
                </div>

                <div class="rating">
                    <h2 class="text-center"> Đánh giá khách hàng về @Model.Name </h2>
                    <form asp-action="AddReview" asp-controller="Comments" method="post" class="mb-4">
                        @Html.AntiForgeryToken() <!-- Bảo vệ CSRF -->

                        <input type="hidden" name="IdTour" value="@Model.IdTour" /> <!-- Đặt IdTour từ Model -->

                        <div class="form-group">
                            <label for="Content">Nội dung:</label>
                            <textarea name="Content" class="form-control" rows="4" required></textarea>
                            @* <span asp-validation-for="Content" class="text-danger"></span> <!-- Hiển thị lỗi nếu có --> *@
                        </div>

                        <button type="submit" class="btn btn-primary btn-block">Gửi Đánh Giá</button>
                    </form>

                    <h3 class="mt-4">Đánh giá hiện có</h3>

                    <div class="list-group">

                        @foreach (var review in Model.Comments)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong>@review.IdNavigation?.fullname</strong>
                                    <small class="text-muted">@review.CommentDate</small>
                                </div>
                                <p class="mt-2">- @review.Content</p>
                            </div>
                        }
                    </div>
                </div>

            </div>

            <div class="col-md-4">
                <div class="info-note">
                    <h2>Thông tin lưu ý</h2>
                    <h4>Giá bao gồm:</h4>
                    <ul class="note-list">
                        <li class="note-item">Vé máy bay khứ hồi</li>
                        <li class="note-item">Chỗ ở tại khách sạn</li>
                        <li class="note-item">Ăn sáng hàng ngày</li>
                    </ul>
                    <h4>Phụ thu:</h4>
                    <ul class="note-list">
                        <li class="note-item">Phụ thu dịp lễ</li>
                    </ul>
                    <h4>Thông tin Visa:</h4>
                    <ul class="note-list">
                        <li class="note-item">Visa được cấp tại sân bay.</li>
                    </ul>
                    <h4>Hủy đổi:</h4>
                    <ul class="note-list">
                        <li class="note-item">Có thể hủy đổi trước 7 ngày.</li>
                    </ul>
                    <h4>Hướng dẫn viên:</h4>
                    <ul class="note-list">
                        <li class="note-item">Hướng dẫn viên chuyên nghiệp, nói tiếng Việt.</li>
                    </ul>
                </div>

                <div class="tour-pricing mt-4">

                    <h2>Đặt tour</h2>

                    <form asp-action="Create" method="post">
                        <input type="hidden" name="tourId" value="@Model.IdTour" />

                        <div class="form-group">
                            <label for="quantity">Số lượng người:</label>
                            <input type="number" id="quantity" name="quantity" class="form-control" min="1" required />
                        </div>

                        <div class="form-group">
                            <label for="pricePerPerson">Giá mỗi người:</label>
                            <input type="text" id="pricePerPerson" class="form-control" value="@Model.Price" readonly />
                        </div>

                        <div class="form-group">
                            <label for="totalPrice">Tổng giá:</label>
                            <input type="text" id="totalPrice" name="totalPrice" class="form-control" readonly />
                        </div>

                        <button type="submit" class="btn btn-primary">Đặt Tour</button>
                    </form>

                  @*   <form asp-action="ProcessPayment" method="post">
                        <input type="hidden" name="invoiceId" value="@ViewBag.InvoiceId" /> <!-- Sử dụng InvoiceId từ ViewBag -->
                        <label>Chọn phương thức thanh toán:</label>
                        <select name="method">

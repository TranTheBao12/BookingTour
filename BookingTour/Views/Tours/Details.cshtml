                    </div>

                </div>
            <div class="tour-pricing mt-4" style="background-color:#ecf0f5">
                <select id="actionSelect" class="dropdown" required>
                    <option value="">...</option>
                    <option value="report">Báo cáo</option>
                    <option value="favorite">Lưu tour</option>
                </select>

                <div id="reportForm" style="display:none;">
                    <form asp-action="Report" asp-controller="Comments" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idTour" value="@Model.IdTour" />

                        <div class="form-group">
                            <label for="Rating"></label>
                            <select name="rating" class="form-control" required>
                                <option value="">Chọn lý do báo cáo</option>
                                <option value="Thông tin không chính xác">1 - Thông tin không chính xác</option>
                                <option value="Giá cả không hợp lý">2 - Giá cả không hợp lý</option>
                                <option value="Dịch vụ kém">3 - Dịch vụ kém</option>
                                <option value="Lịch trình thay đổi đột ngột">4 - Lịch trình thay đổi đột ngột</option>
                                <option value="Hướng dẫn viên thiếu chuyên nghiệp">5 - Hướng dẫn viên thiếu chuyên nghiệp</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary">Gửi báo cáo</button>
                       
                    </form>
            </div>
                <div id="favoriteForm" style="display:none;">
                    @if (isFavorited)
                    {
                        <form asp-action="Unfavorite" asp-controller="Comments" method="post">

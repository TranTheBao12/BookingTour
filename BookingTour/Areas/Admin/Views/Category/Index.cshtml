@model IEnumerable<BookingTour.Models.TypeOfTour>

@{
    ViewData["Title"] = "Danh sách danh mục";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
    <div class="card">
        <div class="header">
            <h2>
                DANH SÁCH DANH MỤC
                <small>Danh sách các danh mục hiện có</small>
            </h2>
            <ul class="header-dropdown m-r--5">
                <li class="dropdown">
                    <a href="javascript:void(0);" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                        <i class="material-icons">more_vert</i>
                    </a>
                    <a href="@Url.Action("Create", "Category", new { area = "Admin" })" class="btn btn-primary">Thêm danh mục</a>
                    <ul class="dropdown-menu pull-right">
                        <li></li>
                        <li><a href="javascript:void(0);" class="waves-effect waves-block">Quản lý danh mục</a></li>
                    </ul>
                </li>
            </ul>
        </div>
        <div class="body table-responsive">
            <table class="table table-bordered table-striped table-hover js-basic-example dataTable">
                <thead class="thead-dark">
                    <tr>
                        <th>Tên Danh Mục</th>
                        <th>Mô Tả</th>
                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Description</td>
                            <td>
                                <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@item.IdType">Sửa</a> |
                                <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@item.IdType">Chi Tiết</a> |
                                <form asp-action="Delete" asp-controller="Category" asp-route-id="@item.IdType" method="post" style="display:inline;">
                                    <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Phần phân trang -->
            <div class="row">
                <div class="col-sm-5">
                    <div class="dataTables_info" role="status" aria-live="polite">
                        Hiển thị từ @(ViewBag.PageSize * (ViewBag.CurrentPage - 1) + 1) đến @(Math.Min(ViewBag.PageSize * ViewBag.CurrentPage, Model.Count())) trong tổng số @ViewBag.TotalTours mục
                    </div>
                </div>
                <div class="col-sm-7">
                    <div class="dataTables_paginate paging_simple_numbers">
                        <ul class="pagination">
                            <li class="paginate_button previous @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                <a href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1 })">Previous</a>
                            </li>
                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="paginate_button @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a href="@Url.Action("Index", new { page = i })">@i</a>
                                </li>
                            }
                            <li class="paginate_button next @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                <a href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1 })">Next</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

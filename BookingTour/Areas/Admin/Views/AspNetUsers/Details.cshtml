@model BookingTour.Models.AspNetUser

@{
    ViewData["Title"] = "Thông Tin Người Dùng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h1 class="text-primary">Thông Tin Người Dùng</h1>

<div class="card mt-4 shadow-sm">
    <div class="card-body">
        <h4 class="card-title text-secondary">Thông Tin Chi Tiết</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3 font-weight-bold">
                Tên người dùng
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.UserName)
            </dd>

            <dt class="col-sm-3 font-weight-bold">
                Tên chuẩn hóa
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.NormalizedUserName)
            </dd>

            <dt class="col-sm-3 font-weight-bold">
                Email
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Email)
            </dd>

            <dt class="col-sm-3 font-weight-bold">
                Email chuẩn hóa
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.NormalizedEmail)
            </dd>

            <dt class="col-sm-3 font-weight-bold">
                Xác nhận Email
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.EmailConfirmed)
            </dd>

            <dt class="col-sm-3 font-weight-bold">
                Số điện thoại
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.PhoneNumber)
            </dd>

           


        </dl>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary mr-2">Chỉnh sửa</a>
    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
</div>

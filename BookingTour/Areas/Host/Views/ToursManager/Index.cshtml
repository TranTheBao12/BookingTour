@model IEnumerable<BookingTour.Models.Tour>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutHost.cshtml";
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}
<div class="card mt-4">
    <div class="card-header bg-dark text-white">
        <h4 class="text-center mb-0">Danh Sách Tour Chờ Duyệt</h4>
    </div>
    <div class="card-body">
        <p class="text-right mb-3">
            <a class="btn btn-primary" asp-action="Create">Tạo Tour Mới</a>
        </p>

        <div class="table-responsive">
            <table class="table table-bordered table-hover table-striped">
                <thead class="thead-dark">
                    <tr>
                        <th>Tên Tour</th>
                        <th>Mô tả</th>
                        <th>Hình Ảnh</th>
                        <th>Ngày Bắt Đầu</th>
                        <th>Ngày Kết Thúc</th>
                        <th>Số Lượng Tối Đa</th>
                        <th>Giá</th>
                        <th>Khách Sạn</th>
                        <th>Phương Tiện</th>
                        <th>Loại Tour</th>
                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.Description)</td>
                            <td>      <img src="@Url.Content("~/images/" + item.Image)"width="100px" alt="Ảnh tour" /></td>
                            <td>@Html.DisplayFor(modelItem => item.StartDate)</td>
                            <td>@Html.DisplayFor(modelItem => item.EndDate)</td>
                            <td>@Html.DisplayFor(modelItem => item.MaxQuantity)</td>
                            <td>@Html.DisplayFor(modelItem => item.Price)</td>
                            <td>@Html.DisplayFor(modelItem => item.IdHotelNavigation.Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.IdTransNavigation.Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.IdTypeNavigation.Name)</td>
                            <td>
                                <a class="btn btn-sm btn-info" asp-action="Edit" asp-route-id="@item.IdTour">Chỉnh Sửa</a>
                                <a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@item.IdTour">Chi Tiết</a>
                                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.IdTour"
                                   onclick="return confirm('Bạn có chắc chắn muốn xóa tour này không?');">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination Controls -->
    <div class="card-footer">
        <div class="d-flex justify-content-center">
            <nav aria-label="Page navigation">
                <ul class="pagination">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)">Trước</a>
                    </li>

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                        </li>
                    }

                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

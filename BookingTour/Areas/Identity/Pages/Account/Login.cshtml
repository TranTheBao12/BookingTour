@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    Layout = null; // Hoặc layout bạn sử dụng
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <script src="https://kit.fontawesome.com/64d58efce2.js" crossorigin="anonymous"></script>
    <link href="~/css/stylelogin.css" rel="stylesheet" />
    <title>Sign in & Sign up Form</title>
</head>
<body>
    <div class="container">
        <div class="forms-container">
            <div class="signin-signup">
                <!-- Sign In Form -->
                <form id="account" method="post" class="sign-in-form">
                    <h2 class="title">Sign in</h2>
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="input-field">
                        <i class="fas fa-user"></i>
                        <input asp-for="Input.Email" autocomplete="username" placeholder="name@example.com" required />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                  
                    <div class="input-field">
                        <i class="fas fa-lock"></i>
                        <input asp-for="Input.Password" autocomplete="current-password" placeholder="password" required />
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label class="form-check-label" asp-for="Input.RememberMe">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
                    </div>

                    <button id="login-submit" type="submit" class="btn btn-primary btn-lg btn-block">Log in</button>
                    <p class="social-text">Or Sign in with social platforms</p>
                    <div class="social-media">
                       
                        <a class=" social-icon" asp-controller="Account" asp-route-returnUrl="@Model.ReturnUrl" asp-action="LoginWithFacebook"> <i class="fab fa-facebook-f"></i></a>






                        <a class="social-icon" asp-controller="Account" asp-action="LoginWithGoogle" asp-route-returnUrl="@Model.ReturnUrl" class="fas fa-envelope"><i class="fab fa-google"></i></a>
                       
                        
                        
                        
                        
                     @*    <button onclick="location.href='@Url.Action("SendOtp", "Account" )'" class="btn btn-primary">
                            Đăng nhập bằng SMS
                        </button> *@
       
                    </div>
          
                </form>


               
            </div>
        </div>
        <div class="panels-container">
            <div class="panel left-panel">
                <div class="content">
                    <h3>Hello</h3>
                    <p>Please register your own account.</p>
                    <button class="btn transparent" id="sign-up-btn" onclick="window.location.href='/Identity/Account/Register'">Sign up</button>

                </div>
                <img src="~/img/log.svg" class="image" alt="" />
            </div>
            <div class="panel right-panel">
                <div class="content">
                    <h3>VIUVIU</h3>
                    <p>Please log in to your account!</p>
                    <button class="btn transparent" id="sign-in-btn" onclick="window.location.href='/Identity/Account/Login'">Sign in</button>
                </div>
                <img src="~/img/register.svg" class="image" alt="" />
            </div>
        </div>
    </div>
    <script src="~/js/app.js"></script>
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>
